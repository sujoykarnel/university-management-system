model CourseRegistration {
  id     String             @id @default(uuid())
  status RegistrationStatus @default(PENDING)

  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  courseOfferingId String
  courseOffering   CourseOffering @relation(fields: [courseOfferingId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  payment     Payment?
  attendances Attendance[]
  results     Result[]

  @@unique([studentId, courseOfferingId], name: "unique_registration_studentId_course")
  @@index([studentId, courseOfferingId], name: "idx_registration_studentId_course")
  @@map("courseRegistration")
}
