model Semester {
  id        String         @id @default(uuid())
  name      String
  year      Int
  startDate DateTime
  endDate   DateTime
  status    SemesterStatus @default(UPCOMING)

  courseOfferings CourseOffering[]

  isDelete  Boolean   @default(false)
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("semesters")
}
