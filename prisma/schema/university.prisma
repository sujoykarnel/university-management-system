model University {
  id        String  @id @default(uuid())
  name      String
  shortName String  @unique
  address   String?
  email     String?
  phone     String?

  departments Department[]

  isDelete  Boolean   @default(false)
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("universities")
}
