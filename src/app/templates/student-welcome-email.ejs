<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>Welcome to University Management System</title>

    <style>
      body {
        font-family: Arial, sans-serif;
        background: #f7f7f7;
        color: #333;
        margin: 0;
        padding: 0;
      }

      .container {
        max-width: 500px;
        margin: 40px auto;
        background: #fff;
        padding: 30px;
        border-radius: 8px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
      }

      h2 {
        color: #1e40af;
        margin-bottom: 20px;
      }

      p {
        line-height: 1.6;
        font-size: 15px;
      }

      .footer {
        margin-top: 30px;
        padding-top: 15px;
        border-top: 1px solid #eee;
        font-size: 12px;
        color: #888;
      }
    </style>
  </head>

  <body>
    <div class="container">
      <h2>
        Welcome to University Management System,
        <%= name %>!
      </h2>

      <p>
        Thank you for joining the University Management System.
        Your account has been created successfully.
      </p>

      <p>
        You can now access your academic information, manage courses,
        view class schedules, check attendance, results, transcripts,
        and stay updated with important university notifications.
      </p>

      <p>
        We are excited to have you as part of our university community.
      </p>

      <div class="footer">
        &copy; University Management System. All rights reserved.
      </div>
    </div>
  </body>
</html>
