
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>Email Verification</title>

    <style>
      body {
        font-family: Arial, sans-serif;
        background: #f7f7f7;
        color: #333;
        margin: 0;
        padding: 0;
      }

      .container {
        max-width: 500px;
        margin: 40px auto;
        background: #fff;
        padding: 30px;
        border-radius: 8px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
      }

      h2 {
        color: #1e40af;
        margin-bottom: 20px;
      }

      p {
        line-height: 1.6;
        font-size: 15px;
      }

      .otp {
        display: inline-block;
        padding: 12px 24px;
        background: #f0f4ff;
        color: #1e40af;
        font-size: 28px;
        font-weight: bold;
        letter-spacing: 8px;
        border-radius: 4px;
        margin: 20px 0;
      }

      .warning {
        font-size: 13px;
        color: #666;
      }

      .footer {
        margin-top: 30px;
        padding-top: 15px;
        border-top: 1px solid #eee;
        font-size: 12px;
        color: #888;
      }
    </style>
  </head>

  <body>
    <div class="container">
      <h2>Email Verification</h2>

      <p>
        Hello <%= name %>,
      </p>

      <p>
        We received a request to verify your email address
        <strong><%= email %></strong> for the
        <strong>University Management System</strong>.
      </p>

      <p>
        Please use the following OTP to verify your email address:
      </p>

      <div class="otp">
        <%= otp %>
      </div>

      <p class="warning">
        This OTP will expire in
        <strong><%= expirationMinutes %> minutes</strong>.
        Please do not share this OTP with anyone.
      </p>

      <p class="warning">
        If you did not request this email verification, you can safely
        ignore this email.
      </p>

      <div class="footer">
        &copy; University Management System. All rights reserved.
      </div>
    </div>
  </body>
</html>
